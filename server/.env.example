# ============================================================
# AURUM Backend Environment Configuration
# Copy this file to .env and fill in your real values.
# ============================================================

NODE_ENV=development
PORT=5000

# MongoDB connection string (MongoDB Atlas recommended)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/aurum

# JWT secret - generate a strong random string (e.g. 64 random chars)
JWT_SECRET=replace-with-a-very-long-random-secret

# JWT expiration
JWT_EXPIRES_IN=7d

# ============================================================
# Payments (only configure the ones you will use)
# ============================================================
# Paystack (Nigeria / Africa) - https://dashboard.paystack.com
PAYSTACK_SECRET_KEY=sk_test_xxxxx

# Stripe (global cards) - https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Frontend URL used in payment redirects and email links
CLIENT_URL=http://localhost:5173

# ============================================================
# Email (optional - used for order confirmations)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=AURUM <no-reply@zealcollection.com>

